<!DOCTYPE html>
<html lang="en">

<head>
</head>

<body>
    <script>
        //4. 오늘 날짜 시간을 출력해라.
        let day = new Date();
        document.write(day + "<br>");

        //4.1 Date 객체로 년, 월, 일도 각각 출력해라.
        let day2 = new Date(2026, 8, 16);
        document.write(day2 + "<br>");
        document.write("년: " + day2.getFullYear() + "<br>");
        document.write("월: " + (day2.getMonth() + 1) + "<br>");
        document.write("일: " + day2.getDate() + "<br>");
    </script>
</body>

</html>
