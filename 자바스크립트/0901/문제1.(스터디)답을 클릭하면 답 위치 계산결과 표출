<!DOCTYPE html>
<html lang="en">

<head>
</head>

<body>

    <h1>계산 해 봅시다.</h1>
    <hr>
    <span id="q1">3 + 4 </span>= <span class="answer1">답</span><br>
    <span id="q2">5 * 20 + 60</span>= <span class="answer2">답</span><br>
    <span id="q3">20 / 5 - 4 * 5</span>= <span class="answer3">답</span><br>

    <script>
        //1. 3 + 4 = 답
        //   5 * 20 + 60 = 답
        //   20/5 - 4 * 5 = 답
        // 답을 클릭하면 답 위치에 계산 결과가 뜬다

        let answer1 = document.querySelector(".answer1");
        let span = document.getElementById('q1');

        console.log(answer1);

        answer1.addEventListener('click', function () {
            answer1.innerText = eval(span.innerText);
        })

        let answer2 = document.querySelector(".answer2");
        let span2 = document.getElementById('q2');

        answer2.addEventListener('click', function () {
            answer2.innerText = eval(span2.innerText);
        })

        let answer3 = document.querySelector(".answer3");
        let span3 = document.getElementById('q3');

        answer3.addEventListener('click', function () {
            answer3.innerText = eval(span3.innerText);
        })
    </script>
</body>

</html>
