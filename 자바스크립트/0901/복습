<!DOCTYPE html>
<html lang="en">

<head>
</head>

<body>
<!--  5. "마우스를 올려줘!" 라는 문자열을 주고 올렸을때 글자색을 pink색으로 변경해라.
  (addEventListener 와 고전방식을 사용)
    <p id="p">마우스를 올려줘!</p>
  -->
    <script>
/*        
        // 1. 점수를 입력받아 90점 이상이면 A, 80~89 사이면 B 그 외는 F 학점으로 처리하여
        // 브라우저에 출력해라.
        let score = parseInt(prompt('점수를 입력하시오.'));
        if (score >= 90) {
            document.write("A");
        }
        else if (score >= 80) {
            document.write("B");
        }
        else {
            document.write("F");
        }
*/
/*
        // 2. 아래와 같이 for문으로 10~35px까지 범위를 주는데,
        // 실제 font-Size로 적용시켜라. (document.write사용)
        // ​document.write(`<span style="font-size:${i}px">${i}px</span>`);

        for (let i = 10; i <= 35; i += 5) {
            document.write(`<span style="font-size:${i}px">${i}px</span>`);
        }
*/
/*
        // 3. 1~10 까지 4로 나눈 나머지가 1인 수만 출력해라(continue 사용)
        for (let i = 1; i <= 10; i++) {
            if (i % 4 != 1) {
                continue;
            }
            else{
                document.write(i + " ");
            }
        }
*/
/*
        // 4. 구구단 출력해라. (for문으로 - > 1미만 ~ 9 이상, 또는 문자(isNaN) 를 입력하면
        // 잘못입력했다고 alert로 출력해라.
        let num = parseInt(prompt('구구단'));
            if (isNaN(num)) {
                alert('다시 입력하시오');
            }
            else if (num < 1 && num > 9) {
                alert('다시 입력하시오');
            }
            else {
                for (let i = 2; i <= 9; i++) {
                    document.write(`${num} * ${i} = ${num * i} <br>`);
                }
            }
*/
/*
        5."마우스를 올려줘!" 라는 문자열을 주고 올렸을때 글자색을 pink색으로 변경해라. (onmouseover)
        (addEventListener 와 고전방식을 사용)
        let p = document.getElementById('p');

        p.addEventListener('mouseenter', function () {
            this.style.color = "pink";
        });

        p.onmouseenter = function () {
            this.style.color = "pink";
        }
*/
</script>
    </script>
</body>

</html>
