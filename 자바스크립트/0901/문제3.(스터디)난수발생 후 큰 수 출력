<body>
    <script>
        //3. 1에서 100포함해서 사이의 난수 10개를 생성하여
        // ary이름의 배열에 저장하고 
        // 배열에 저장된 수 중 가장 큰 수를 출력해라.
        const list = Array(10).fill(0).map(() =>
            Math.floor(Math.random() * 101)
        );
        const sortList = list.sort((a, b) => a - b);
        document.write(sortList.at(-1))
    </script>
</body>

</html>
