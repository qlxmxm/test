<!DOCTYPE html>
<html lang="en">

<head>
</head>

<body>
    <div class="question">
        Q. 컴퓨터 분야 뭐가 관심있니?
        <button class="answer">답보기</button>
    </div>
    <div class="question">
        Q. 뭐 먹고 싶니?
        <button class="answer">답보기</button>
    </div>
    <script>
        //3. 1에서 100포함해서 사이의 난수 10개를 생성하여
        // ary이름의 배열에 저장하고 
        // 배열에 저장된 수 중 가장 큰 수를 출력해라.
        const answer = ['서버', '짜장면'];
        const questionList = document.querySelectorAll('.question');
        questionList.forEach((q, i) => {
            q.querySelector('.answer').addEventListener('click', () => {
                if (q.querySelector('.answerText')) return;
                const text = document.createElement('p');
                text.className = 'answerText';
                text.innerHTML = answer[i];
                q.append(text);
            });
        });
    </script>
</body>

</html>
