<!DOCTYPE html>
<html lang="en">

<head>
</head>

<body>
    <h1>할 일 목록</h1>
    <ul>
        <li class="1"><span class="check">v</span> 할 일 1</li>
        <li class="2"><span class="check">v</span> 할 일 2</li>
        <li class="3"><span class="check">v</span> 할 일 3</li>
        <li class="4"><span class="check">v</span> 할 일 4</li>
        <li class="5"><span class="check">v</span> 할 일 5</li>
    </ul>
    <script>
        //2. 할일 목록을 주고 li클릭할때마다 li태그만 선택해서 red로 바꾸기
        let n = document.querySelectorAll('li');

        n.forEach(function (li) {
            li.addEventListener('click', function () {
                li.style.color = 'red';
            });
        });
    </script>
</body>

</html>
